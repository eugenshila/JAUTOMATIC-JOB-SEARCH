# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# virtualenvs
.venv/
venv/
env/

# build output / frozen app
build/
dist/
*.spec
*.msi
*.exe

# ...but the PyInstaller spec is source, and so is the dotnet tool manifest
!packaging/jautomatic.spec

# generated at MSI build time (never check in)
packaging/files.wxs
packaging/version_info.txt
.venv-packaging/

# headless Qt helper libraries generated by tools/genstubs.py
.stublibs/
.screenshot-data/

# app data (when running with --data-dir .)
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
documents/
exports/
