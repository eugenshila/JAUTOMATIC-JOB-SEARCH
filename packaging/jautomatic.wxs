<?xml version="1.0" encoding="UTF-8"?>
<!--
  JAUTOMATIC JOB SEARCH — WiX installer shell (built with WiX v5.0.2, see
  packaging/build_info.py WIX_VERSION and .config/dotnet-tools.json).

  This file holds the hand-written half of the installer: product identity,
  upgrade policy, folders, shortcuts and the Add/Remove Programs entries.
  The other half — one Component per file of the PyInstaller bundle — is
  generated at build time by packaging/gen_files_wxs.py into files.wxs
  (a frozen Qt app is hundreds of files; hand-maintaining that list would
  rot within a release).

  Build inputs (passed as -d variables by packaging/build.ps1):
    ProductVersion   3-part version from jautomatic.__version__ (1.0.0)
    FrozenDir        PyInstaller output dir (dist\jautomatic)
    IconPath         absolute path to packaging\jautomatic.ico - WiX looks for
                     relative source paths against its binder input paths and
                     the current working directory, not against this file, so
                     the icon is handed over absolute instead of by name.

  Upgrades: MajorUpgrade only — every release uninstalls the previous one.
  The UpgradeCode below is the product's permanent identity: it must NEVER
  change (changing it orphans existing installs).  New major WiX note: WiX v6+
  accepts a human-readable Package/@Id as a replacement for the UpgradeCode
  GUID; see packaging/README.md "Upgrading WiX" before touching this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="JAUTOMATIC JOB SEARCH"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="JAUTOMATIC"
           UpgradeCode="6723609b-1b49-46f6-ad03-7554cbade5de"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of JAUTOMATIC JOB SEARCH is already installed. Setup will now exit." />
    <Media Id="1" Cabinet="jautomatic.cab" EmbedCab="yes" />

    <!-- Add/Remove Programs branding + help link -->
    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/eugenshila/JAUTOMATIC-JOB-SEARCH" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/eugenshila/JAUTOMATIC-JOB-SEARCH" />

    <!-- Install layout: %ProgramFiles%\JAUTOMATIC + Start Menu\JAUTOMATIC -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="JAUTOMATIC" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="JAUTOMATIC" />
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcuts" Guid="a1351c73-6cbf-4223-9a88-1b604fd09cff" Bitness="always64">
        <Shortcut Id="StartMenuShortcut"
                  Name="JAUTOMATIC JOB SEARCH"
                  Description="Local-first desktop job-search autopilot"
                  Target="[INSTALLFOLDER]jautomatic.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <!-- Install marker; doubles as the component key path.  HKLM on
             purpose: this key belongs to the machine-wide install and is
             removed with it.  The app itself writes nothing to the registry —
             window geometry lives in the data dir's settings.json (1.0 used
             an HKCU QSettings key; the leftover is disclosed in
             docs/install-windows.md). -->
        <RegistryValue Root="HKLM"
                       Key="Software\JAUTOMATIC\job-search"
                       Name="installed"
                       Value="[ProductVersion]"
                       Type="string"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="JAUTOMATIC JOB SEARCH" Level="1">
      <ComponentGroupRef Id="FrozenFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>
  </Package>
</Wix>
